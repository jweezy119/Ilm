# Copy to deploy/.env.tunnel.local and edit. Compose reads it through tunnel.sh.
# This file is a template, not a secret.

# Match these to an existing database if you already ingested the corpus.
# The README's local Postgres uses postgres/postgres and the volume below.
POSTGRES_DB=ilm
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# Set to ilm_postgres_data to reuse the corpus you ingested with `npm run ingest`.
POSTGRES_VOLUME=ilm_tunnel_postgres_data

# Optional. Sefaria rate-limits bursts. The defaults pause 750ms between
# chapter requests and back off from 1s on a 429. Raise both if an ingest
# still stalls.
SEFARIA_DELAY_MS=750
INGEST_RETRY_BASE_MS=1000

# Basic gate for the public tunnel. Set both to enable it; the browser shows
# its own login prompt. Leave either empty to turn the gate off.
ILM_BASIC_USER=ilm
ILM_BASIC_PASS=change-me-please

# Optional. Generate with: openssl rand -hex 32
ADMIN_TOKEN=

# Optional. Without keys every AI feature uses its deterministic fallback and
# the UI labels the result as derived.
TYPESAFE_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# Optional. The tunnel URL is random, so leave SITE_URL empty unless you have a
# stable hostname. With no contact address the contact page says so plainly.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_CONTACT_EMAIL=
CORS_ORIGIN=http://localhost:3000

# postgres searches the whole corpus in the database. orama needs ~1.5 GB RAM.
SEARCH_ENGINE=postgres
API_HEAP_MB=512
