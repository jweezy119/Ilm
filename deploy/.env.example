# Copy to deploy/.env and fill in. Compose reads this file automatically from
# the directory the compose file lives in, and bootstrap.sh sources it.
#
# Anything with a value here is a real secret. .env is gitignored.

# --- required ---------------------------------------------------------------

# Postgres superuser password for the bundled container.
POSTGRES_PASSWORD=change-me

# Required by POST /api/admin/reindex in production (sent as x-admin-token).
# Generate one:  openssl rand -hex 32
ADMIN_TOKEN=change-me

# Public hostnames. Both must resolve to this machine before Caddy can get a
# certificate. See deploy/README.md for the free DuckDNS option.
ILM_HOST=ilm.example.duckdns.org
ILM_API_HOST=api.ilm.example.duckdns.org

# Your email, for the Let's Encrypt account. Expiry notices go here.
CADDY_ACME_EMAIL=you@example.com

# --- required, but harmless to leave as the default ------------------------

# Used for metadata/absolute URLs in the UI.
NEXT_PUBLIC_SITE_URL=https://ilm.example.duckdns.org

# A real address for corrections and search-log deletion requests. The privacy
# policy promises that mechanism; without this the contact page says plainly
# that contact is not configured, and a RENDER/CI build refuses to ship.
NEXT_PUBLIC_CONTACT_EMAIL=

# The web app is same-origin, so this only matters if you call the API from
# another page. Comma-separate multiple origins.
CORS_ORIGIN=https://ilm.example.duckdns.org

# --- optional ---------------------------------------------------------------

POSTGRES_DB=ilm
POSTGRES_USER=ilm

# The API runs TypeScript from source via tsx. 512 is comfortable for the full
# corpus; the code default is 320.
API_HEAP_MB=512

# postgres (default) searches the whole corpus in the database. `orama` is the
# old in-process index and needs roughly 1.5 GB for the full corpus.
SEARCH_ENGINE=postgres

# Spoken audio. The default voice is Google Translate's public TTS endpoint,
# which is free and needs no account but has no published quota. Every
# distinct text is synthesised once and then read off disk, so a chapter
# costs one upstream request rather than one per listener.
TTS_CACHE_DIR=/app/data/tts-cache
# Stop writing past this and prune the oldest files. 0 disables the budget.
TTS_CACHE_MAX_BYTES=4000000000

# No keys is a supported configuration: search is not re-ranked by meaning,
# cross-references fall back to keyword overlap, and themes and alignments use
# local scoring. /health reports jev.configured: false and the UI says so.
TYPESAFE_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
