# Ilm API — copy to .env and fill in what you have.
# Everything except DATABASE_URL has a working default, so the API boots without
# AI credentials and tells you which features are degraded.

# ---------------------------------------------------------------- application
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info

# ------------------------------------------------------------------- database
# The bundled compose file maps Postgres to 5433 so it does not collide with a
# Postgres already on 5432.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/ilm?schema=public

# ------------------------------------------------------- TypeSafe (Jev / Jev)
# Without this, recommendation scoring, alignment typing, theme classification and
# search-intent detection fall back to deterministic local scoring. The API still
# works; /health reports jev.configured=false so the UI can say so.
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai
TYPESAFE_DEFAULT_MODEL=jev-latest
TYPESAFE_TIMEOUT_MS=30000
TYPESAFE_MAX_RETRIES=2

# ------------------------------------------------------------------ embeddings
# Optional. Feeds vector similarity into candidate ranking. OpenRouter is tried
# first, then OpenAI. Leave both blank and ranking uses lexical overlap only.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BATCH_SIZE=64

# --------------------------------------------------------------------- runtime
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_MAX=600
RATE_LIMIT_WINDOW=60000

# How many candidates get scored per recommendation request. Five dimensions each,
# so this is the single biggest token cost in the app; 12 is enough for the ranking
# the reader sees. Lower still if the budget is tight.
RECOMMEND_SHORTLIST=12

# Hard ceiling on what this process spends on the hosted judge, in dollars.
# 0 disables the cap. Checked before every request, so a runaway backfill stops
# rather than quietly billing. Resets when the process restarts.
JEV_BUDGET_USD=0

# ------------------------------------------------------------------- search
# Which retrieval engine answers searches.
#   postgres  Full-text search in the database. Covers the whole corpus, holds no
#             index in this process's memory, and searches the English scripture
#             text as well as theme names. Default.
#   orama     The in-process index. Matches theme names, book slugs and translation
#             names, but never the scripture text, and holds every passage in RAM
#             (~35 KB each), so it can only cover a subset. Kept for rollback.
SEARCH_ENGINE=postgres

# Which texts the in-memory search index covers. Ignored by the postgres engine,
# which has no such limit; applies only to SEARCH_ENGINE=orama. The index lives in RAM, so its
# size is bounded by the instance, not the corpus: a one-property index over all
# 45,453 passages already needs ~745 MB. Whole texts, so a text is either
# searchable or absent. "all" needs a bigger instance and no code change.
# Measured peak RSS, full schema: quran ~340 MB, quran+torah ~430 MB.
SEARCH_INDEX_TEXTS=quran,torah

# V8 heap ceiling in MB for the API process. Pinned so V8 cannot grow toward the
# container limit and get the process OOM-killed; the index build completes well
# inside it. Raise on a larger instance.
API_HEAP_MB=320

# Passages Jev re-ranks per query. One request carries all of them plus the
# corpus-level relevance check, so this is the whole per-search cost.
SEARCH_RERANK_LIMIT=24
# Share of the blended search score taken from Jev rather than full-text.
# Lower it if you want literal matches to dominate.
SEARCH_JEV_WEIGHT=0.75
# How much a passage's coverage of the query's words discounts its full-text
# score, and how much its index-time semantic density can lift it.
SEARCH_COVERAGE_WEIGHT=0.65
SEARCH_DENSITY_WEIGHT=0.15
# Neighbours examined per passage when detecting cross-references.
CROSSREF_CANDIDATES=30

# --------------------------------------------------------------------- indexing
# Reindexing is exposed at POST /api/admin/reindex. Send this header in production.
# ADMIN_TOKEN=
