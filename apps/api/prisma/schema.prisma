// Prisma Schema for Ilm - Sacred Text Comparison Platform
// Run: npx prisma generate && npx prisma db push

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// Text & Passage Models
// ============================================================================

model Text {
  id           String   @id @default(cuid())
  textId       String   @unique @map("text_id") // quran, talmud, torah, ot, nt
  name         String
  originalLang String   @map("original_lang")
  direction    String   @default("ltr") // rtl or ltr
  bookCount    Int      @default(0) @map("book_count")
  verseCount   Int      @default(0) @map("verse_count")
  metadata     Json     @default("{}")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  books        Book[]
  passages     Passage[]
  translations Translation[]

  @@index([textId])
  @@map("texts")
}

model Book {
  id           String   @id @default(cuid())
  textId       String   @map("text_id")
  text         Text     @relation(fields: [textId], references: [textId], onDelete: Cascade)
  bookId       String   @map("book_id") // e.g., "2" for Al-Baqarah, "john" for John
  name         String
  nameOriginal String?  @map("name_original")
  nameTranslit String?  @map("name_translit")
  chapterCount Int      @default(0) @map("chapter_count")
  verseCount   Int      @default(0) @map("verse_count")
  order        Int
  testament    String? // old, new, quran, talmud, torah
  category     String? // pentateuch, gospel, pauline, meccan, medinan, etc.
  description  String?
  metadata     Json     @default("{}")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  passages Passage[]
  chapters Chapter[]

  @@unique([textId, bookId])
  @@index([textId, order])
  @@map("books")
}

model Chapter {
  id           String   @id @default(cuid())
  bookRef      String   @map("book_ref")
  book         Book     @relation(fields: [bookRef], references: [id], onDelete: Cascade)
  number       Int
  name         String? // Surah name, etc.
  nameOriginal String?  @map("name_original")
  verseCount   Int      @default(0) @map("verse_count")
  metadata     Json     @default("{}")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  passages Passage[]

  @@unique([bookRef, number])
  @@index([bookRef])
  @@map("chapters")
}

model Passage {
  id                   String          @id @default(cuid())
  passageKey           String          @unique @map("passage_key") // quran:2:255, nt:john:3:16
  textId               String          @map("text_id")
  text                 Text            @relation(fields: [textId], references: [textId], onDelete: Cascade)
  bookRef              String          @map("book_ref")
  book                 Book            @relation(fields: [bookRef], references: [id], onDelete: Cascade)
  bookSlug             String          @map("book_slug")
  chapterRef           String          @map("chapter_ref")
  chapter              Chapter         @relation(fields: [chapterRef], references: [id], onDelete: Cascade)
  chapterNum           Int             @map("chapter_num")
  verseNum             Int             @map("verse_num")
  originalText         String          @map("original_text") @db.Text
  primaryTranslation   String          @map("primary_translation") @db.Text
  primaryTranslationId String?         @map("primary_translation_id")
  language             String          @default("english")
  verseOrder           Int             @map("verse_order") // Global ordering within text
  metadata             Json            @default("{}")
  // Semantic embeddings stored as JSON array (or use pgvector extension)
  embeddings           Json?           @default("[]")
  figureMentions       FigureMention[]
  createdAt            DateTime        @default(now()) @map("created_at")
  updatedAt            DateTime        @updatedAt @map("updated_at")

  themes              PassageTheme[]
  passageTranslations PassageTranslation[]
  crossRefsSource     CrossReference[]     @relation("CrossRefSource")
  crossRefsTarget     CrossReference[]     @relation("CrossRefTarget")
  alignmentsSource    Alignment[]          @relation("AlignmentSource")
  alignmentsTarget    Alignment[]          @relation("AlignmentTarget")
  affinitiesSource    PassageAffinity[]    @relation("AffinitySource")
  affinitiesTarget    PassageAffinity[]    @relation("AffinityTarget")

  @@index([textId, verseOrder])
  @@index([textId, bookSlug, chapterNum, verseNum])
  @@index([passageKey])
  @@map("passages")
}

// ============================================================================
// Translation Models
// ============================================================================

model Translation {
  id         String   @id @default(cuid())
  textId     String   @map("text_id")
  text       Text     @relation(fields: [textId], references: [textId], onDelete: Cascade)
  name       String // e.g., "Sahih International", "KJV", "ESV"
  language   String   @default("english")
  translator String?
  year       Int?
  isPrimary  Boolean  @default(false) @map("is_primary")
  license    String? // public_domain, creative_commons, proprietary
  sourceUrl  String?  @map("source_url")
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  passageTranslations PassageTranslation[]

  @@unique([textId, name, language])
  @@map("translations")
}

model PassageTranslation {
  id            String      @id @default(cuid())
  passageId     String      @map("passage_id")
  passage       Passage     @relation(fields: [passageId], references: [id], onDelete: Cascade)
  translationId String      @map("translation_id")
  translation   Translation @relation(fields: [translationId], references: [id], onDelete: Cascade)
  text          String      @db.Text
  // When this row was last compared with Sefaria's own text. Null means "not yet
  // checked", which is every row written before the repair existed. Only the
  // self-repair reads it; see migrations/13_translation_verified_at.
  verifiedAt DateTime? @map("verified_at")

  createdAt     DateTime    @default(now()) @map("created_at")

  @@unique([passageId, translationId])
  @@index([passageId])
  @@map("passage_translations")
}

// ============================================================================
// Thematic Analysis (Jev-powered)
// ============================================================================

model Theme {
  id          String   @id @default(cuid())
  name        String   @unique
  category    String? // divine_attributes, covenant_law, salvation, etc.
  description String?
  taxonomy    String[] @default([]) // hierarchical path
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  passageThemes PassageTheme[]

  @@index([category])
  @@map("themes")
}

model PassageTheme {
  id         String   @id @default(cuid())
  passageId  String   @map("passage_id")
  passage    Passage  @relation(fields: [passageId], references: [id], onDelete: Cascade)
  // Stores Theme.name, not Theme.id, so theme queries stay readable and stable.
  themeId    String   @map("theme_id")
  theme      Theme    @relation(fields: [themeId], references: [name], onDelete: Cascade)
  score      Float    @default(0) // 0-1 from Jev Score
  confidence Float    @default(0) // 0-1 from Jev
  evidence   String[] @default([])
  source     String   @default("jev") // jev, manual, derived
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([passageId, themeId])
  @@index([passageId])
  @@index([themeId, score])
  @@map("passage_themes")
}

// ============================================================================
// Cross-References (Jev-detected)
// ============================================================================

model CrossReference {
  id              String   @id @default(cuid())
  sourcePassageId String   @map("source_passage_id")
  sourcePassage   Passage  @relation("CrossRefSource", fields: [sourcePassageId], references: [id], onDelete: Cascade)
  targetPassageId String   @map("target_passage_id")
  targetPassage   Passage  @relation("CrossRefTarget", fields: [targetPassageId], references: [id], onDelete: Cascade)
  type            String // quote, allusion, thematic, linguistic, narrative, theological
  strength        Float    @default(0) // 0-1 from Jev Score
  direction       String   @default("bidirectional") // bidirectional, source_to_target, target_to_source
  notes           String?
  detectedBy      String   @default("jev") @map("detected_by") // jev, manual
  matchedSegments Json     @default("[]") // [{textA, textB, startA, endA, startB, endB}]
  createdAt       DateTime @default(now()) @map("created_at")

  @@unique([sourcePassageId, targetPassageId, type])
  @@index([sourcePassageId])
  @@index([targetPassageId])
  @@index([type, strength])
  @@map("cross_references")
}

// ============================================================================
// Alignments (for side-by-side comparison)
// ============================================================================

model Alignment {
  id              String   @id @default(cuid())
  sourcePassageId String   @map("source_passage_id")
  sourcePassage   Passage  @relation("AlignmentSource", fields: [sourcePassageId], references: [id], onDelete: Cascade)
  targetPassageId String   @map("target_passage_id")
  targetPassage   Passage  @relation("AlignmentTarget", fields: [targetPassageId], references: [id], onDelete: Cascade)
  type            String // direct_quote, strong_allusion, thematic_parallel, linguistic_cognate, narrative_parallel, theological_echo, none
  strength        Float    @default(0)
  matchedSegments Json     @default("[]")
  notes           String?
  createdAt       DateTime @default(now()) @map("created_at")

  @@unique([sourcePassageId, targetPassageId])
  @@index([sourcePassageId])
  @@index([targetPassageId])
  @@map("alignments")
}

/// Per-dimension affinity between two passages, as judged once and reused.
///
/// The five dimension scores do not depend on the reader's weights — only the
/// composite does — so they are stored without a composite and recombined on read.
/// That is what lets the weight sliders re-rank instantly and for free, which is
/// what the settings page promises.
/// A figure named across traditions, and the passages that name them.
///
/// Not a cross-reference, and the difference matters. A cross-reference is a relation
/// between two passages — this passage quotes that one. A figure is not a passage, so
/// an edge between every attesting passage would be 26 × 963 edges for Jesus alone
/// and almost none of them would mean anything. The relation is passage → figure,
/// which is a different shape and needs a different table.
///
/// One row per passage that names the figure, carrying the surface form found, so the
/// page can show that the Qur'an says عيسى, the Gospels Ἰησοῦς and the hadith يسوع
/// for one person. The differing names are most of what is interesting about the
/// relation and an edge would have thrown them away.
model Figure {
  id        String   @id @default(cuid())
  slug      String   @unique // jesus
  /// The name used in the product's own voice, in English.
  name      String
  /// Why these passages are the same figure, with the citation that establishes it.
  ///
  /// The identification is not made here. The Qur'an makes it of Isa at 4:171 and
  /// 3:45 — "the Messiah, Jesus son of Mary" — so the basis is a passage in the
  /// corpus rather than an opinion of this product, and the page links it.
  basis     Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")

  mentions FigureMention[]

  @@map("figures")
}

/// One passage naming a figure.
model FigureMention {
  id        String  @id @default(cuid())
  figureId  String  @map("figure_id")
  figure    Figure  @relation(fields: [figureId], references: [id], onDelete: Cascade)
  passageId String  @map("passage_id")
  passage   Passage @relation(fields: [passageId], references: [id], onDelete: Cascade)

  /// The surface form found in this passage's original text, for display.
  form   String
  /// Whether this corpus's references attest the figure or argue against it.
  ///
  /// The Talmud names Yeshu in a handful of polemical passages, which are evidence
  /// that the name was in use and evidence of a dispute — not a confession. Filing
  /// those beside the Gospels without the distinction would present a polemic as
  /// agreement, so the stance travels with the mention.
  stance String @default("attesting") // attesting | polemical

  @@unique([figureId, passageId])
  @@index([figureId, stance])
  @@index([passageId])
  @@map("figure_mentions")
}

model PassageAffinity {
  id              String   @id @default(cuid())
  sourcePassageId String   @map("source_passage_id")
  sourcePassage   Passage  @relation("AffinitySource", fields: [sourcePassageId], references: [id], onDelete: Cascade)
  targetPassageId String   @map("target_passage_id")
  targetPassage   Passage  @relation("AffinityTarget", fields: [targetPassageId], references: [id], onDelete: Cascade)
  /// The five dimension scores. Deliberately no composite: it depends on weights.
  scores          Json     @default("{}")
  confidence      Float    @default(0)
  /// Whether a model judged this pair or a local rule did.
  source          String   @default("jev")
  createdAt       DateTime @default(now()) @map("created_at")

  @@unique([sourcePassageId, targetPassageId])
  @@index([sourcePassageId])
  @@map("passage_affinities")
}

/// A lexicon entry, as published by a historical dictionary.
///
/// Reference data, not generated text: these are the real entries from BDB,
/// Jastrow, Klein and Strong's, each kept with the dictionary it came from so the
/// reader can see which tradition is defining the word.
model LexiconEntry {
  id              String   @id @default(cuid())
  /// The word as looked up, with vowel points and cantillation removed, so every
  /// vocalisation of one root shares a cache row.
  lookupWord      String   @map("lookup_word")
  /// The dictionary's own headword, with its pointing, which is what to display.
  headword        String
  lexicon         String
  language        String   @default("hebrew")
  transliteration String?
  strongNumber    String?  @map("strong_number")
  morphology      String?
  /// The entry's senses, verbatim, as an array of strings.
  senses          Json     @default("[]")
  /// Attribution for the dictionary itself.
  source          String?
  createdAt       DateTime @default(now()) @map("created_at")

  @@unique([lookupWord, lexicon, headword])
  @@index([lookupWord])
  @@map("lexicon_entries")
}

// ============================================================================
// Search & Analytics
// ============================================================================
model XlingualTerm {
  id          String   @id @default(cuid())
  // Theme.name, for the same reason PassageTheme stores the name: these are looked
  // up by taxonomy slug from a query string.
  theme       String
  language    String // hebrew | greek | arabic | aramaic
  // The term in the corpus's own orthography, folded at query time.
  term        String
  inPassages  Int      @default(0) @map("in_passages")
  // How far this term's distribution inside the theme exceeds its distribution
  // corpus-wide. Kept so a wrong row can be diagnosed rather than just deleted.
  specificity Float    @default(0)
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([theme, language, term])
  @@index([theme])
  @@map("xlingual_terms")
}

model SearchLog {
  id          String   @id @default(cuid())
  query       String
  intent      String?
  filters     Json     @default("{}")
  resultCount Int      @map("result_count")
  tookMs      Int      @map("took_ms")
  userId      String?  @map("user_id")
  sessionId   String?  @map("session_id")
  ipHash      String?  @map("ip_hash")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([userId])
  @@map("search_logs")
}

model UserPreference {
  id                    String   @id @default(cuid())
  userId                String   @unique @map("user_id")
  // RecommendationWeights, stored as JSON
  weights               Json     @default("{}")
  preferredTexts        String[] @default([]) @map("preferred_texts")
  preferredTranslations Json     @default("{}") @map("preferred_translations")
  uiSettings            Json     @default("{}") @map("ui_settings")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@map("user_preferences")
}

// ============================================================================
// Library
// ============================================================================

// What a reader kept.
//
// A passage key, not a search result and not a copy of the text. The passage is
// already in `passages` and can be corrected, re-translated or re-ingested; a
// duplicate copy here would be a second thing to keep in step, and it could
// disagree with the first. Storing the key means an entry cannot go stale, and
// hydrating a page is one batched query rather than N.
//
// Keyed by an anonymous id in a cookie. There is no account, and `email` on
// Collection exists only so that "claim this library" can be a later migration
// rather than a rewrite. Until then it is null and nothing reads it.
model SavedPassage {
  id         String @id @default(cuid())
  userId     String @map("user_id")
  passageKey String @map("passage_key")

  // Null means "kept, not filed". Most saved passages are, on the grounds that
  // asking someone to name a collection before they have saved anything is a
  // question they have no context to answer.
  collectionId String? @map("collection_id")

  createdAt DateTime @default(now()) @map("created_at")

  collection Collection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)

  // One save per passage, so a double click cannot produce two rows and the
  // unsave endpoint has something unambiguous to delete.
  @@unique([userId, passageKey])
  @@index([userId, createdAt(sort: Desc)])
  @@map("saved_passages")
}

// A journey: a reader's own path through the corpora, as a set of passages they
// chose and the order they put them in.
//
// Node set and ordering only. The edges are read at query time from
// cross_references, alignments and passage_themes, so every edge already carries
// the provenance that detected it. There is deliberately no journey_edges table:
// a user-authored edge would be the reader's assertion wearing the same weight as
// a detected quotation, and the UI could not tell them apart afterwards. A
// reader's own connection between two passages is a note on the node.
model Journey {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  nodes JourneyNode[]

  @@unique([userId, name])
  @@index([userId, updatedAt(sort: Desc)])
  @@map("journeys")
}

model JourneyNode {
  id         String @id @default(cuid())
  journeyId  String @map("journey_id")
  passageKey String @map("passage_key")

  // The reader's ordering, not the corpus order: the order they put the passages
  // in is the argument they are making, and it is the one thing not derivable.
  position Int @default(0)
  note     String?

  createdAt DateTime @default(now()) @map("created_at")

  journey Journey @relation(fields: [journeyId], references: [id], onDelete: Cascade)

  // One node per passage per journey. The same passage may sit in several
  // journeys: two readings of one verse are two journeys.
  @@unique([journeyId, passageKey])
  @@index([journeyId, position])
  @@map("journey_nodes")
}

// A named group of saved passages. Unused by the first version of the library,
// which saves without filing; the table exists so that adding collections is a
// change to the UI and not a second migration.
model Collection {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  name      String
  email     String?
  createdAt DateTime @default(now()) @map("created_at")

  passages SavedPassage[]

  @@unique([userId, name])
  @@map("collections")
}

// ============================================================================
// Indexing Jobs (BullMQ)
// ============================================================================

model IndexingJob {
  id             String    @id @default(cuid())
  type           String // full_reindex, incremental, passage_update, theme_extract, crossref_detect, alignment_compute
  status         String    @default("pending") // pending, running, completed, failed
  progress       Int       @default(0)
  totalItems     Int       @default(0) @map("total_items")
  processedItems Int       @default(0) @map("processed_items")
  error          String?
  metadata       Json      @default("{}")
  startedAt      DateTime? @map("started_at")
  completedAt    DateTime? @map("completed_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([status])
  @@index([type, status])
  @@map("indexing_jobs")
}
